## =============================================================
## DocuVector Lite — Variáveis de ambiente (template)
##
## INSTRUÇÕES (Windows PowerShell):
##   copy .env.example .env
##   notepad .env
##
## REGRA: nunca commitar .env real. Já está em .gitignore.
## =============================================================

## --- Aplicação ---
APP_ENV=development
APP_NAME=DocuVector Lite
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

## --- PostgreSQL (Docker Compose lê estas mesmas variáveis) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docuvector
POSTGRES_USER=docuvector_app
POSTGRES_PASSWORD=trocar_por_senha_forte_local
## URL completa derivada (usada pelo SQLAlchemy/Alembic).
## Deixar exatamente assim em dev local; em CI/CD seria injetada pelo orquestrador.
DATABASE_URL=postgresql+psycopg://docuvector_app:trocar_por_senha_forte_local@localhost:5432/docuvector

## --- ChromaDB (vector store persistente local) ---
CHROMA_PERSIST_DIR=./data/chroma

## --- JWT ---
## Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=trocar_por_segredo_de_64_chars_hex_gerado_aleatoriamente
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

## --- Seed de usuários iniciais ---
## Senha mínima de 8 caracteres. NUNCA usar estes valores em produção.
SEED_ADMIN_EMAIL=admin@docuvector.local
SEED_ADMIN_PASSWORD=trocar_admin_demo_123

SEED_USER1_EMAIL=user1@docuvector.local
SEED_USER1_PASSWORD=trocar_user1_demo_123

SEED_USER2_EMAIL=user2@docuvector.local
SEED_USER2_PASSWORD=trocar_user2_demo_123

## --- Provedor de embedding remoto (OpenAI) ---
## Pode ficar vazio para rodar 100% offline; o front exibe aviso.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_COST_PER_MILLION_TOKENS=0.02

## --- Provedor de embedding local (Sentence Transformers / E5) ---
SENTENCE_TRANSFORMERS_MODEL=intfloat/multilingual-e5-small
SENTENCE_TRANSFORMERS_DIMENSIONS=384
## Diretório de cache dos pesos (padrão do HuggingFace funciona, isto é opcional)
HF_HOME=./data/hf_cache

## --- Provedor de LLM (resposta da query) ---
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_LLM_TEMPERATURE=0.2
OPENAI_LLM_MAX_TOKENS=600

## --- RAG (parâmetros do pipeline) ---
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6

## --- Limites operacionais ---
UPLOAD_MAX_BYTES=10485760
LOGIN_RATE_LIMIT_PER_MINUTE=10
