# JurisVector — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o arquivo .env real.

# =============================================================
# Aplicação
# =============================================================
APP_NAME="JurisVector"
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development          # development | production
SECRET_KEY=troque-por-uma-string-aleatoria-de-64-chars

# =============================================================
# Banco de dados (PostgreSQL)
# =============================================================
DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/jurisvector

# =============================================================
# ChromaDB — persistência local
# =============================================================
CHROMA_PERSIST_DIR=./data/chroma

# Nomes das coleções (configuráveis por ambiente)
CHROMA_COLLECTION_ORIGINAL=docuvector
CHROMA_COLLECTION_INT8=docuvector_int8
CHROMA_COLLECTION_BINARY=docuvector_binary
CHROMA_COLLECTION_PCA=docuvector_pca
CHROMA_COLLECTION_RP=docuvector_rp

# Dimensão alvo para PCA e RandomProjection (padrão: metade de 384)
CHROMA_PCA_TARGET_DIM=192

# =============================================================
# HuggingFace — cache local do modelo E5
# =============================================================
HF_HOME=./data/hf_cache
SENTENCE_TRANSFORMERS_MODEL=intfloat/multilingual-e5-small

# =============================================================
# OpenAI (opcional — deixe em branco para usar apenas Ollama)
# =============================================================
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_LLM_TEMPERATURE=0.2
OPENAI_LLM_MAX_TOKENS=600

# =============================================================
# Ollama (LLM local)
# =============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# =============================================================
# LLM padrão
# =============================================================
LLM_DEFAULT_PROVIDER=ollama   # mock | ollama | openai

# =============================================================
# RAG — parâmetros de retrieval
# =============================================================
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# =============================================================
# Upload
# =============================================================
UPLOAD_MAX_BYTES=10485760    # 10 MB

# =============================================================
# Admin bootstrap (seed automático no startup)
# =============================================================
SEED_ADMIN_EMAIL=admin@jurisvector.com
SEED_ADMIN_PASSWORD=TrocarpelaSenhaForte!2026

# =============================================================
# Bcrypt
# =============================================================
BCRYPT_ROUNDS=12             # 4 em testes, 12 em produção

# =============================================================
# Taxa de câmbio (para conversão BRL nas métricas)
# =============================================================
USD_TO_BRL_RATE=5.70
